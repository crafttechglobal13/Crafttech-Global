# ==============================================================================
# Hostinger Premium Plan (LiteSpeed / Apache) Web Server Configuration
# CRAFTTECH GLOBAL - Optimized for Static HTML Export & Clean URLs
# ==============================================================================

DirectoryIndex out/index.html index.html index.php

# Prevent 403 Forbidden directory listing error
Options -Indexes +FollowSymLinks

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. If root URL requested, serve out/index.html
    RewriteRule ^$ out/index.html [L]

    # 2. If requesting directly inside out/, serve it directly
    RewriteCond %{REQUEST_URI} ^/out/
    RewriteRule ^ - [L]

    # 3. If exact file exists in out/, serve it
    RewriteCond %{DOCUMENT_ROOT}/out%{REQUEST_URI} -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/out%{REQUEST_URI} -d
    RewriteRule ^(.*)$ out/$1 [L]

    # 4. If path has index.html inside out/, serve it
    RewriteCond %{DOCUMENT_ROOT}/out/$1/index.html -f
    RewriteRule ^(.*)/?$ out/$1/index.html [L]

    # 5. Fallback 404 handler
    ErrorDocument 404 /out/404/index.html
</IfModule>

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>
