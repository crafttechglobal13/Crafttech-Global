# ==============================================================================
# CRAFTTECH GLOBAL - ENVIRONMENT VARIABLES EXAMPLE
# ==============================================================================

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/crafttech_global?schema=public"

# Authentication & Security
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_secure_random_string_here"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="CRAFTTECH GLOBAL"
NEXT_PUBLIC_CURRENCY="INR"
NEXT_PUBLIC_SUPPORTED_CURRENCIES="INR,USD,GBP,EUR"

# Payment Gateways
# Razorpay (India & South Asia)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# Stripe (International Payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_signing_secret"

# Media Storage (Cloudinary)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Email Services (Resend)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="orders@crafttechglobal.com"
ADMIN_EMAIL="care@crafttechglobal.com"

